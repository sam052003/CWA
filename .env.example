# ==============================================================================
# CWA Taiwan Weather Forecast — Environment Variables Example
# 複製此檔案為 .env 並填入實際設定值（切勿將 .env 提交至版本庫）
# ==============================================================================

# 應用程式設定
APP_NAME=CWA Taiwan Weather Forecast
ENVIRONMENT=development
PORT=8000

# 中央氣象署 (CWA) Open Data API Key
# 申請網址: https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=your_cwa_api_key_here

# Supabase PostgreSQL 連線字串 (使用 psycopg driver)
# 格式: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your_project.supabase.co:5432/postgres
