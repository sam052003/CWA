# ==============================================================================
# CWA Taiwan Weather Forecast — Environment Variables Example
# 複製此檔案為 .env 並填入實際設定值（切勿將 .env 提交至版本庫）
# ==============================================================================

# 應用程式設定
APP_NAME=CWA Taiwan Weather Forecast
ENVIRONMENT=development
PORT=8000

# 中央氣象署 (CWA) Open Data API Key
# 申請網址: https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=your_cwa_api_key_here

# Supabase PostgreSQL 連線字串 (使用 Transaction Pooler 與 psycopg driver)
# 格式: postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres

# Vercel Cron Protected Endpoint Secret (生產環境定時更新金鑰)
# 格式: 32+ 字元隨機字串，由 python -c "import secrets; print(secrets.token_urlsafe(32))" 產生
CRON_SECRET=your_random_cron_secret_here

